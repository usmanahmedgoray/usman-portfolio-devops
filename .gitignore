# Node modules (copied via Dockerfile stages)
node_modules
npm-debug.log

# Git
.git
.gitignore

# IDE
.vscode
.idea
*.swp
*.swo

# Environment & Secrets (NEVER include in image)
.env*
!.env.example
*.pem
*.key

# Build outputs (will be generated in container)
.next
out
dist

# Logs & Temp
logs
*.log
tmp
temp

# Docker files (not needed inside image)
Dockerfile*
docker-compose*.yml
.dockerignore

# Tests & Docs (not needed in production)
__tests__
*.test.js
*.spec.js
coverage
docs
README.md